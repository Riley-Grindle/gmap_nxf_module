plugins {
  id 'nf-float'
}

workDir = '/mnt/jfs/nextflow/working'

process {
    executor = 'float'
    errorStrategy = 'retry'

    withName: 'GMAP' {
        cpus   = { 10 }
        memory = {  72.GB  }
        time   = {  16.h   }
    }
    withName: "GMAP_BUILD" {
        cpus   = { 10 }
        memory = {  72.GB  }
        time   = {  16.h   }
    }
}

podman.registry = 'quay.io'

float {
    address = '10.192.10.185:443'
    username = 'rgrindle'
    password = 'reg4901'
    timefactor      = 10
    commonExtra ='  --dataVolume [opts=" --cache-dir /mnt/jfs_cache "]jfs://10.192.10.37:6868/1:/mnt/jfs --dataVolume [size=120]:/mnt/jfs_cache --customTag gmap:jfs-OD-dec-11 --dumpMode incremental --vmPolicy [spotOnly=true,retryLimit=10,retryInterval=300s]'
}

aws {
  client {
    maxConnections = 20
    connectionTimeout = 300000
  }
  accessKey = ''
  secretKey = ''
}

tower {
    accessToken = ''
}